{
  "name": "omniprofile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w extension",
    "build:web": "npm run build -w web",
    "build:extension": "npm run build -w extension",
    "dev:extension": "npm run dev -w extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w web",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.18"
  }
}
