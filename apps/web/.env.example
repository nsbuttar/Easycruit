# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used for the extension token tables and extension API routes.
SUPABASE_SECRET_KEY=sb_secret_...

# OpenAI
OPENAI_API_KEY=sk-...
# Optional model overrides
# OPENAI_CV_MODEL=gpt-4o
# OPENAI_MAPPING_MODEL=gpt-4o-mini

# Public origin of this app (used for auth email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Chrome extension IDs allowed to connect.
# Required in production; when empty in development any extension ID is accepted.
EXTENSION_ALLOWED_IDS=
